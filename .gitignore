# Estado local de Wrangler (base D1 de prueba, cache de build).
# No debe subirse: es especifico de cada maquina y puede pesar mucho.
.wrangler/

# Dependencias
node_modules/

# Configuracion local del editor/agente
.claude/

# Registros
*.log

# Secretos locales (tokens, claves). Nunca deben subirse al repositorio.
docs/_secretos_locales/
