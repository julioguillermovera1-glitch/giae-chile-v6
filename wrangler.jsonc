{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "giae-chile-v6",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-07",
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // D1 y R2 activos desde 2026-07-29 con los recursos reales de la cuenta.
  "d1_databases": [
    {
      "binding": "GIAE_DB",
      "database_name": "giae-db",
      "database_id": "716dc984-14d4-4160-82bd-efc62801d84e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "GIAE_PROJECT_BACKUPS",
      "bucket_name": "giae-project-backups"
    },
    {
      "binding": "GIAE_PROJECT_DOCUMENTS",
      "bucket_name": "giae-project-documents"
    },
    {
      "binding": "GIAE_BRAND_ASSETS",
      "bucket_name": "giae-brand-assets"
    },
    {
      "binding": "GIAE_FIELD_MEDIA",
      "bucket_name": "giae-field-media"
    }
  ],
  "vars": {
    "GIAE_ENV": "production",
    "GIAE_BINDINGS_MODE": "active"
  }
}
