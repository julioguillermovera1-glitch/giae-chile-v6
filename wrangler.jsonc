{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "giae-chile-v6",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-07",
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GIAE_ENV": "production",
    "GIAE_BINDINGS_MODE": "pending"
  }
}
